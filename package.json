{
  "name": "react-native-goo-toast",
  "version": "0.3.0",
  "description": "Gooey, physics-based morphing toasts for React Native. Skia goo filter + Reanimated springs, all on the UI thread.",
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "assets",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "expo",
    "toast",
    "skia",
    "reanimated",
    "gooey",
    "morph",
    "dynamic-island",
    "sound",
    "soundcn",
    "haptics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwamicodes/react-native-goo-toast.git"
  },
  "bugs": {
    "url": "https://github.com/qwamicodes/react-native-goo-toast/issues"
  },
  "homepage": "https://github.com/qwamicodes/react-native-goo-toast#readme",
  "author": "Kwaame Ofori-Adjekum (https://github.com/qwamicodes)",
  "license": "MIT",
  "peerDependencies": {
    "@shopify/react-native-skia": ">=1.0.0",
    "expo-haptics": "*",
    "react": ">=18.2.0",
    "react-native": ">=0.76.0",
    "react-native-gesture-handler": ">=2.16.0",
    "react-native-reanimated": ">=3.10.0",
    "react-native-safe-area-context": ">=4.10.0",
    "expo-audio": "*"
  },
  "devDependencies": {
    "@shopify/react-native-skia": "^2.0.0",
    "@types/react": "^19.1.0",
    "expo-haptics": "^15.0.0",
    "react": "^19.1.0",
    "react-native": "^0.81.0",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-reanimated": "^4.1.0",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-worklets": "^0.5.0",
    "typescript": "^5.6.0",
    "expo-audio": "*"
  },
  "bin": {
    "goo-sound": "bin/goo-sound.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./haptics": {
      "types": "./src/haptics.ts",
      "default": "./src/haptics.ts"
    },
    "./sounds": {
      "types": "./src/sounds.ts",
      "default": "./src/sounds.ts"
    },
    "./package.json": "./package.json"
  },
  "peerDependenciesMeta": {
    "expo-haptics": {
      "optional": true
    },
    "expo-audio": {
      "optional": true
    }
  }
}
